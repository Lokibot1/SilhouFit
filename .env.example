VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# Google sign-in: enable the Google provider in the Supabase dashboard (Authentication -> Providers) and add
# http://localhost:5173/auth/callback and the production <origin>/auth/callback under
# Authentication -> URL Configuration -> Redirect URLs.
# Public https origin of the site, used for email links (sign-up confirmation) sent from the native app.
VITE_SITE_URL=
# Set to true only once Google has approved the app for the birthday scope; until then it blocks everyone but listed test users.
VITE_GOOGLE_BIRTHDAY=
